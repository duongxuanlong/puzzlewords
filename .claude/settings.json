{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run validate:levels)",
      "Bash(npm run lint)",
      "Bash(npm run solver:report)",
      "Bash(npm run solver:report -- *)",
      "Bash(node tools/solve-level.js *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node tools/hooks/guard-paths.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node tools/hooks/after-edit.js", "timeout": 120 }
        ]
      }
    ]
  }
}
